# --- Python & Environment ---
__pycache__/
*.py[cod]
*$py.class
.env
venv/
.vscode/
.idea/
.DS_Store

# --- Project Specific ---
# NEVER commit raw data, logs, or research notebooks
data/
notebooks/
story.txt
/logs

# --- Artifact Isolation (CRITICAL FOR GITOPS) ---
# Ignore all historical research checkpoints to prevent repository bloat
artifacts/*
# Explicitly whitelist the production models required by the Docker container
!artifacts/prod/
